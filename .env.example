# ============================================================================
# Environment Variables Template (.env.example)
# ============================================================================
# Copy this file to '.env' for local Docker Compose development.
# DO NOT commit actual secrets, API keys, or private credentials to Git.
# ============================================================================

# Application Environment Identifier (BLUE or GREEN)
APP_ENVIRONMENT=BLUE

# Application Semantic Version (e.g., 1.0.0, 2.0.0, or Git SHA)
APP_VERSION=1.0.0

# ASP.NET Core Hosting Environment (Development / Staging / Production)
ASPNETCORE_ENVIRONMENT=Production

# Nginx HTTP Host Port Mapping (Access API at http://localhost:8080)
HOST_PORT=8080
